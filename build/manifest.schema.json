{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ordered Jiangxi userscript source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "output", "modules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "versionToken": { "const": "{{SCRIPT_VERSION}}" },
    "output": { "const": "jiangxi-radiation-auto-diagnose.user.js" },
    "modules": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "order"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "file": { "type": "string", "pattern": "^src/(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:\u0000]+\\.js$" },
          "order": { "type": "integer", "minimum": 0 },
          "description": { "type": "string" }
        }
      }
    }
  },
  "$comment": "The dependency-free builder additionally enforces consecutive order, unique ids and physical files, actual filesystem containment, metadata/runtime version equality, syntax, and generated-output synchronization."
}
