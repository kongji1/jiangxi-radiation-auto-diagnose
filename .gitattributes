# Keep installable and module sources portable.
* text=auto
*.js text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Fragment endings preserve the exact whitespace of the assembled userscript.
src/*.js whitespace=-blank-at-eof
